{
  "name": "SecureVision",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env -- turbo run dev --env-mode=loose",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prettier": "3.9.6",
    "turbo": "^2.11.9",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.19.0"
}
